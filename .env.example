# Local simulation is the default. No AWS credentials belong in browser config.
VITE_QR_MODE=local
# After deployment, generate .env.local from its public outputs; see docs/dashboard-aws.md.
# VITE_QR_MODE=aws
# VITE_QR_REGION=us-east-1
# VITE_QR_API_URL=https://API_ID.execute-api.us-east-1.amazonaws.com
# VITE_QR_COGNITO_URL=https://YOUR_DOMAIN.auth.us-east-1.amazoncognito.com
# VITE_QR_COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
# VITE_QR_REDIRECT_URI=http://localhost:5173/
