# Copy to terraform.tfvars (ignored by Git), then replace the example account ID.
aws_account_id    = "123456789012"
aws_profile       = "queuerescue-dev"
aws_region        = "us-east-1"
environment       = "dev"
budget_alert_email = ""
monthly_budget_usd = 10
# Set an email before deployment to receive budget and alarm notifications.
# This is an account-wide alert, not a hard spending cap.
protect_data          = true
allow_destroy_evidence = false
replay_enabled         = true
