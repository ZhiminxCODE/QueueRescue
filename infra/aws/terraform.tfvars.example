# Copy to terraform.tfvars (ignored by Git), then replace the example account ID.
aws_account_id    = "123456789012"
aws_profile       = "queuerescue-dev"
aws_region        = "us-east-1"
environment       = "dev"
cost_profile      = "minimal"
# For a fresh synthetic demo only, minimal removes fixed-cost extras; it is not a $0 guarantee.
consumers_enabled = false
budget_alert_email = ""
monthly_budget_usd = 0.01
# Set an email before deployment to receive budget and alarm notifications.
# This is an account-wide alert, not a hard spending cap.
# An additional zero-spend notification warns about metered costs before credits.
protect_data          = true
allow_destroy_evidence = false
replay_enabled         = false
audit_logging_enabled    = false
audit_collection_enabled = false
audit_retention_days     = 7
# Opt-in audit resources have separate storage/event/monitoring costs and an
# additional active Lambda reservation. Review before provisioning or capture.
# Keep audit_logging_enabled=true once provisioned; pause via collection=false.
